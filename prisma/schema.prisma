// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  USER
  ADMIN
  SUPERADMIN
}

enum Gender {
  L
  P
}

enum Status {
  DIPROSES
  DITERIMA
  DITOLAK
}

model User {
  id              String           @id @default(uuid())
  username        String
  email           String           @unique
  password        String
  role            UserRole         @default(USER)
  refreshToken    String?
  suratKelahirans SuratKelahiran[]
  suratKematians  SuratKematian[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SuratKelahiran {
  id                  String    @id @default(uuid())
  namaTerkait         String
  jenisKelaminTerkait Gender
  tempatLahirTerkait  String
  tanggalLahirTerkait DateTime
  alamatTerkait       String
  namaAyah            String
  jenisKelaminAyah    Gender
  agamaAyah           String
  alamatAyah          String
  tempatLahirAyah     String
  tanggalLahirAyah    DateTime
  namaIbu             String
  jenisKelaminIbu     Gender
  agamaIbu            String
  alamatIbu           String
  tempatLahirIbu      String
  tanggalLahirIbu     DateTime
  status              Status    @default(DIPROSES)
  pesanDitolak        String?
  noSurat             String?
  tanggalPembuatan    DateTime?
  User                User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId              String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SuratKematian {
  id                      String    @id @default(uuid())
  namaPemohon             String
  jenisKelaminPemohon     Gender
  noNikPemohon            String
  alamatPemohon           String
  hubunganKeluargaPemohon String
  namaTerkait             String
  jenisKelaminTerkait     Gender
  noNikTerkait            String
  alamatTerkait           String
  tanggal                 DateTime
  penyebab                String
  tempat                  String
  status                  Status    @default(DIPROSES)
  pesanDitolak            String?
  noSurat                 String?
  tanggalPembuatan        DateTime?
  User                    User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId                  String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
