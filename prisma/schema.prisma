  id               String           @id @default(uuid())
  nama             String
  nik              String
  noKk             String
  tempatLahir      String
  tanggalLahir     DateTime
  jenisKelamin     Gender
  statusPerkawinan StatusPerkawinan
  pekerjaan        String
  agama            String
  alamat           String

  status           Status    @default(DIPROSES)
  pesanDitolak     String?
  noSurat          String?
  tanggalPembuatan DateTime?

  User   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SkUsaha {
  id               String           @id @default(uuid())
  namaLengkap      String
  nik              String
  tanggalLahir     DateTime
  jenisKelamin     Gender
  agama            String
  pekerjaan        String
  statusPerkawinan StatusPerkawinan
  kewarganegaraan  String
  alamat           String
  namaUsaha        String
  alamatUsaha      String

  status           Status    @default(DIPROSES)
  pesanDitolak     String?
  noSurat          String?
  tanggalPembuatan DateTime?

  User   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
