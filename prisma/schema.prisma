// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  USER
  ADMIN
  SUPERADMIN
}

enum Gender {
  L
  P
}

enum StatusPerkawinan {
  BELUM_KAWIN
  KAWIN
  CERAI_HIDUP
  CERAI_MATI
}

enum Status {
  DIPROSES
  DITERIMA
  DITOLAK
}

model User {
  id           String   @id @default(uuid())
  username     String
  nomorWa      String   @unique
  password     String
  role         UserRole @default(USER)
  ktpUrl       String?
  kkUrl        String?
  refreshToken String?

  suratKelahirans       SuratKelahiran[]
  suratKematians        SuratKematian[]
  skBelumMenikahs       SkBelumMenikah[]
  skIjinKeramaian       SkIjinKeramaian[]
  skPenghasilanOrangTua SkPenghasilanOrangTua[]

  createdAt                DateTime                   @default(now())
  updatedAt                DateTime                   @updatedAt
  SkIzinBekerja            SkIzinBekerja[]
  SkBelumMemilikiRumah     SkBelumMemilikiRumah[]
  SkTidakMemilikiPekerjaan SkTidakMemilikiPekerjaan[]
}

model Setting {
  id             String @id @default(uuid())
  namaKepalaDesa String
  tte            Bytes?

  namaBabinsa    String
  pangkatBabinsa String
  nrpBabinsa     String
  jabatanBabinsa String

  namaBhabinkamtibmas    String
  pangkatBhabinkamtibmas String
  nrpBhabinkamtibmas     String
  jabatanBhabinkamtibmas String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SuratKelahiran {
  id                  String    @id @default(uuid())
  namaTerkait         String
  jenisKelaminTerkait Gender
  tempatLahirTerkait  String
  tanggalLahirTerkait DateTime
  kampungTerkait      String
  rtTerkait           String
  rwTerkait           String
  namaAyah            String
  jenisKelaminAyah    Gender
  agamaAyah           String
  kampungAyah         String
  rtAyah              String
  rwAyah              String
  tempatLahirAyah     String
  tanggalLahirAyah    DateTime
  namaIbu             String
  jenisKelaminIbu     Gender
  agamaIbu            String
  kampungIbu          String
  rtIbu               String
  rwIbu               String
  tempatLahirIbu      String
  tanggalLahirIbu     DateTime
  status              Status    @default(DIPROSES)
  pesanDitolak        String?
  noSurat             String?
  tanggalPembuatan    DateTime?
  User                User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId              String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SuratKematian {
  id                      String   @id @default(uuid())
  namaPemohon             String
  jenisKelaminPemohon     Gender
  noNikPemohon            String
  kampungPemohon          String
  rtPemohon               String
  rwPemohon               String
  hubunganKeluargaPemohon String
  namaTerkait             String
  jenisKelaminTerkait     Gender
  noNikTerkait            String
  kampungTerkait          String
  rtTerkait               String
  rwTerkait               String
  tanggal                 DateTime
  penyebab                String
  tempat                  String
  status                  Status   @default(DIPROSES)

  pesanDitolak     String?
  noSurat          String?
  tanggalPembuatan DateTime?

  User   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SkBelumMenikah {
  id               String           @id @default(uuid())
  namaLengkap      String
  nik              String
  tanggalLahir     DateTime
  jenisKelamin     Gender
  agama            String
  pekerjaan        String
  statusPerkawinan StatusPerkawinan
  kewarganegaraan  String
  kampung          String
  rt               String
  rw               String

  namaKua          String?
  status           Status    @default(DIPROSES)
  pesanDitolak     String?
  noSurat          String?
  tanggalPembuatan DateTime?

  User   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SkIjinKeramaian {
  id           String   @id @default(uuid())
  nama         String
  nik          String
  tempatLahir  String
  tanggalLahir DateTime
  kampung      String
  rt           String
  rw           String
  waktu        DateTime
  maksud       String
  acara        String

  status           Status    @default(DIPROSES)
  pesanDitolak     String?
  noSurat          String?
  tanggalPembuatan DateTime?

  User   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SkPenghasilanOrangTua {
  id               String           @id @default(uuid())
  namaLengkap      String
  nik              String
  tanggalLahir     DateTime
  jenisKelamin     Gender
  agama            String
  pekerjaan        String
  statusPerkawinan StatusPerkawinan
  kewarganegaraan  String
  kampung          String
  rt               String
  rw               String
  penghasilan      Int

  status           Status    @default(DIPROSES)
  pesanDitolak     String?
  noSurat          String?
  tanggalPembuatan DateTime?

  User   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SkIzinBekerja {
  id             String   @id @default(uuid())
  namaLengkap    String
  nik            String
  tanggalLahir   DateTime
  jenisKelamin   Gender
  agama          String
  pekerjaan      String
  bagian         String
  nomorId        String
  kampung        String
  rt             String
  rw             String
  tempatKerja    String
  alasan         String
  izinDariHari   DateTime
  izinSampaiHari DateTime

  status           Status    @default(DIPROSES)
  pesanDitolak     String?
  noSurat          String?
  tanggalPembuatan DateTime?

  User   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SkBelumMemilikiRumah {
  id               String           @id @default(uuid())
  namaLengkap      String
  nik              String
  tanggalLahir     DateTime
  jenisKelamin     Gender
  agama            String
  pekerjaan        String
  statusPerkawinan StatusPerkawinan
  kewarganegaraan  String
  kampung          String
  rt               String
  rw               String
  keperluan        String

  status           Status    @default(DIPROSES)
  pesanDitolak     String?
  noSurat          String?
  tanggalPembuatan DateTime?

  User   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SkTidakMemilikiPekerjaan {
  id               String           @id @default(uuid())
  nama             String
  nik              String
  noKk             String
  tempatLahir      String
  tanggalLahir     DateTime
  jenisKelamin     Gender
  statusPerkawinan StatusPerkawinan
  pekerjaan        String
  agama            String
  kampung          String
  rt               String
  rw               String

  status           Status    @default(DIPROSES)
  pesanDitolak     String?
  noSurat          String?
  tanggalPembuatan DateTime?

  User   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
