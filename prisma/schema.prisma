model SkDomisiliLembaga {
  id            String   @id @default(uuid())
  nama          String
  tempatLahir   String
  tanggalLahir  DateTime
  jabatan       String
  alamat        String
  namaLembaga   String
  alamatLembaga String

  status           Status    @default(DIPROSES)
  pesanDitolak     String?
  noSurat          String?
  tanggalPembuatan DateTime?

  User   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SkDomisiliImigrasi {
  id               String           @id @default(uuid())
  namaLengkap      String
  tanggalLahir     DateTime
  jenisKelamin     Gender
  agama            String
  pekerjaan        String
  statusPerkawinan StatusPerkawinan
  kewarganegaraan  String
  alamat           String
  keperluan        String

  namaCamat        String?
  status           Status    @default(DIPROSES)
  pesanDitolak     String?
  noSurat          String?
  tanggalPembuatan DateTime?

  User   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SkDomisiliSementara {
  id                String           @id @default(uuid())
  namaLengkap       String
  nik               String
  tanggalLahir      DateTime
  jenisKelamin      Gender
  agama             String
  pekerjaan         String
  statusPerkawinan  StatusPerkawinan
  kewarganegaraan   String
  alamat            String
  domisiliSementara String

  status           Status    @default(DIPROSES)
  pesanDitolak     String?
  noSurat          String?
  tanggalPembuatan DateTime?

  User   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
